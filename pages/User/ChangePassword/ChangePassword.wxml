<!--pages/User/ChangePhone/ChangePassword.wxml-->
<view class="container">
  <form bindsubmit="onSubmit">
      <!-- 显示手机号 -->
      <view class="form-card">
        <label class="form-label">您的手机号:</label>
        <view class="phone-container">
          <text class="phone-text">{{phoneNumber}}</text>
        </view>
      </view>

      <!-- 验证码 -->
      <view class="form-card">
        <label class="form-label">验证码:</label>
        <view class="input-container code-container">
          <input
            class="input code-input"
            type="number"
            name="smsCode"
            placeholder="请输入验证码"
            data-name="smsCode"
            bindinput="handleSmsCodeInput"
          />
          <button 
            class="code-btn" 
            type="default" 
            bindtap="sendSmsCode"
            disabled="{{countdown > 0}}"
          >
            {{countdown > 0 ? countdown + 's后重试' : '获取验证码'}}
          </button>
        </view>
      </view>

      <!-- 新密码 -->
      <view class="form-card">
        <label class="form-label">新密码:</label>
        <view class="input-container">
          <input
            class="input"
            password
            name="newPassword"
            placeholder="请输入新密码"
            data-name="newPassword"
            bindinput="onInputChange"
          />
        </view>
      </view>

      <!-- 确认新密码 -->
      <view class="form-card">
        <label class="form-label">确认新密码:</label>
        <view class="input-container">
          <input
            class="input"
            password
            name="confirmPassword"
            placeholder="请再次输入新密码"
            data-name="confirmPassword"
            bindinput="onInputChange"
          />
        </view>
      </view>

    <!-- 提交按钮 -->
    <view class="container">
      <button class="submit-button" formType="submit">提交</button>
    </view>
  </form>
</view>