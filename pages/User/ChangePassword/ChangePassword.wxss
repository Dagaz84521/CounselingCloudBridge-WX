/* 原样式保留部分 */
.container {
  padding: 30rpx;
}

.form-card {
  margin-bottom: 30rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  /** 新增阴影效果 **/
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.form-label {
  color: #666;
  font-size: 28rpx;
  margin-bottom: 15rpx;
}

.submit-button {
  background: #07c160;
  color: white;
  margin-top: 50rpx;
}

/* 需要删除的部分 */
/* 移除旧版输入框的冗余样式（如果有类似样式） */
.input-container input {
  /* 旧版输入框的特殊样式 */
}

/* 需要新增/修改的样式 */

/** 手机号展示样式 **/
.phone-container {
  padding: 20rpx 0;
}

.phone-text {
  color: #333;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.6;
}

/** 验证码容器 **/
.code-container {
  display: flex;
  gap: 20rpx;  /* 元素间距 */
  align-items: center;
}

.code-input {
  flex: 1;
  min-width: 0;  /* 防止内容溢出 */
}

.code-btn {
  /** 基础样式 **/
  background: #f0f0f0;
  color: #333;
  font-size: 26rpx;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 25rpx;
  border-radius: 8rpx;
  transition: all 0.3s;
}

/** 输入框通用样式 **/
.input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  font-size: 30rpx;
}

/** 密码输入框额外间距 **/
.form-card:nth-last-child(2) {
  margin-bottom: 50rpx;
}